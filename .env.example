# VoiceStreamAI Configuration Template
# Copy this file to .env and fill in your credentials

# Server Configuration
HOST=0.0.0.0
PORT=8080
BASE_URL=https://your-ngrok-url.ngrok-free.app

# VAD Configuration
VAD_TYPE=silero
# VAD_TYPE options: silero, pyannote, webrtc
# Note: pyannote requires HF_TOKEN (HuggingFace token)

# ASR Configuration
ASR_TYPE=groq
# ASR_TYPE options: elevenlabs, groq, faster_whisper
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GROQ_API_KEY=your_groq_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# SSL Configuration (optional, for production)
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

# WebSocket Server Configuration (optional, for browser clients)
WS_HOST=localhost
WS_PORT=8765

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
