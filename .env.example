# VoiceStreamAI Configuration Template
# Copy this file to .env and fill in your credentials

# Server Configuration
HOST=0.0.0.0
PORT=8080
BASE_URL=https://your-ngrok-url.ngrok-free.app

# HuggingFace Configuration (for PyAnnote VAD)
HF_TOKEN=your_huggingface_token_here

# VAD Configuration
VAD_TYPE=pyannote
# VAD_TYPE options: pyannote, silero, webrtc

# ASR Configuration
ASR_TYPE=faster_whisper
ASR_MODEL_SIZE=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# ASR_MODEL_SIZE options: tiny, base, small, medium, large-v2, large-v3
# ASR_DEVICE options: cpu, cuda
# ASR_COMPUTE_TYPE options: int8, float16, float32

# SSL Configuration (optional, for production)
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

# WebSocket Server Configuration (optional, for browser clients)
WS_HOST=localhost
WS_PORT=8765

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
